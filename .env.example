# Databricks Lakebase Connection Settings
LAKEBASE_PROJECT=your-project-id
LAKEBASE_BRANCH=production
LAKEBASE_ENDPOINT=primary
LAKEBASE_HOST=your-endpoint.database.us-east-2.cloud.databricks.com
LAKEBASE_DATABASE=databricks_postgres
LAKEBASE_ROLE=your-service-principal-id-or-email
LAKEBASE_SCHEMAS=your_schema,public

# OAuth token (leave blank for auto-refresh via Databricks CLI)
LAKEBASE_TOKEN=

# Google Gemini API Key (optional — heuristic fallback is active if omitted)
GEMINI_API_KEY=
